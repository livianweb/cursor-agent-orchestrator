#!/usr/bin/env bash
# configure — alias del wizard (install.sh sin ruta) + utilidades legacy.
#
# Uso:
#   ./configure              igual que ./install.sh (wizard HTTP en :8765)
#   ./configure --open-file  abre setup/index.html sin servidor
#   ./configure --print      imprime URLs y pasos
#   ./configure --kit-git    inicializa .askbox/git-settings.json del kit (capa C)
#
#   CONFIGURE_HOST (default 0.0.0.0) — interfaz del servidor
#   CONFIGURE_PORT (default 8765)
#   CONFIGURE_TOKEN — opcional; exige cabecera en POST /api/install
#
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SETUP_DIR="$ROOT/setup"
INDEX="$SETUP_DIR/index.html"
HOST="${CONFIGURE_HOST:-0.0.0.0}"
PORT="${CONFIGURE_PORT:-8765}"
PRINT_ONLY=0
OPEN_FILE=0
INIT_KIT_GIT=0

configure_lan_ip() {
  local ip=""
  if command -v ip >/dev/null 2>&1; then
    ip="$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i <= NF; i++) if ($i == "src") { print $(i + 1); exit }}')"
  fi
  if [ -z "$ip" ] && command -v hostname >/dev/null 2>&1; then
    ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
  fi
  printf '%s' "$ip"
}

print_serve_urls() {
  echo "  Local:  http://127.0.0.1:$PORT/"
  local lan
  lan="$(configure_lan_ip)"
  if [ -n "$lan" ] && [ "$HOST" != "127.0.0.1" ]; then
    echo "  Red:    http://${lan}:$PORT/  (otros equipos en la LAN)"
  elif [ "$HOST" = "127.0.0.1" ]; then
    echo "  (solo localhost; para LAN: CONFIGURE_HOST=0.0.0.0 ./install.sh)"
  fi
}

open_setup_file() {
  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$INDEX"
    return 0
  fi
  if command -v sensible-browser >/dev/null 2>&1; then
    sensible-browser "$INDEX"
    return 0
  fi
  if command -v open >/dev/null 2>&1; then
    open "$INDEX"
    return 0
  fi
  echo "No hay xdg-open/sensible-browser. Abre: file://$INDEX" >&2
  return 1
}

for arg in "$@"; do
  case "$arg" in
    --print) PRINT_ONLY=1 ;;
    --open-file) OPEN_FILE=1 ;;
    --kit-git) INIT_KIT_GIT=1 ;;
    -h|--help)
      sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
  esac
done

if [ "$INIT_KIT_GIT" = "1" ]; then
  if [ ! -f "$ROOT/.askbox/git-settings.json" ] && [ -f "$ROOT/.askbox/git-settings.json.example" ]; then
    mkdir -p "$ROOT/.askbox"
    cp "$ROOT/.askbox/git-settings.json.example" "$ROOT/.askbox/git-settings.json"
    echo "Capa C: creado $ROOT/.askbox/git-settings.json (edítalo y configura gh/remoto del kit)."
  else
    echo "Capa C: .askbox/git-settings.json ya existe o falta el .example."
  fi
fi

if [ ! -f "$INDEX" ]; then
  echo "ERROR: no se encuentra $INDEX" >&2
  exit 1
fi

FILE_URL="file://$INDEX"

if [ "$PRINT_ONLY" = "1" ]; then
  echo "cursor-agent-orchestrator — configuración post-clone"
  echo "  Repo:    $ROOT"
  echo "  Abre en el navegador (con ./install.sh en marcha):"
  print_serve_urls
  echo "  Sin servidor:  ./configure --open-file"
  echo "  API install:   POST http://127.0.0.1:$PORT/api/install"
  exit 0
fi

if [ "$OPEN_FILE" = "1" ]; then
  echo "Abriendo guía sin servidor HTTP: $INDEX"
  echo "Nota: Instalar desde la UI requiere ./install.sh (servidor con API)."
  open_setup_file
  exit 0
fi

if [ $# -gt 0 ] && [ "$INIT_KIT_GIT" != "1" ]; then
  echo "Opción no reconocida. Usa ./configure --help" >&2
  exit 1
fi

if [ "$INIT_KIT_GIT" = "1" ] && [ $# -eq 1 ]; then
  exit 0
fi

exec "$ROOT/install.sh" --wizard
