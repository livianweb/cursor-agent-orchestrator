#!/usr/bin/env bash
# configure — asistente post-clone del kit (capas A/B/C). No usa askbox /settings/git.
#
# Uso:
#   ./configure              abre la guía en el navegador (servidor local efímero)
#   ./configure --print      solo imprime la URL file:// y los pasos
#   ./configure --kit-git    inicializa .askbox/git-settings.json del kit (capa C)
#
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SETUP_DIR="$ROOT/setup"
INDEX="$SETUP_DIR/index.html"
PORT="${CONFIGURE_PORT:-8765}"
PRINT_ONLY=0
INIT_KIT_GIT=0

for arg in "$@"; do
  case "$arg" in
    --print) PRINT_ONLY=1 ;;
    --kit-git) INIT_KIT_GIT=1 ;;
    -h|--help)
      sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
  esac
done

if [ "$INIT_KIT_GIT" = "1" ]; then
  if [ ! -f "$ROOT/.askbox/git-settings.json" ] && [ -f "$ROOT/.askbox/git-settings.json.example" ]; then
    mkdir -p "$ROOT/.askbox"
    cp "$ROOT/.askbox/git-settings.json.example" "$ROOT/.askbox/git-settings.json"
    echo "Capa C: creado $ROOT/.askbox/git-settings.json (edítalo y configura gh/remoto del kit)."
  else
    echo "Capa C: .askbox/git-settings.json ya existe o falta el .example."
  fi
fi

echo "cursor-agent-orchestrator — configuración post-clone"
echo "  Repo:    $ROOT"
echo "  Guía UI: $INDEX"
echo "  Docs:    $ROOT/docs/getting-started-after-clone.md"
echo
echo "Pasos rápidos:"
echo "  1) Capa A — export ASKBOX_API_URL y ASKBOX_ACCESS_TOKEN (entorno Cursor/host)"
echo "  2) Capa B — ./install.sh /ruta/a/tu-proyecto  (+ git/gh en ese proyecto)"
echo "  3) Capa C — gh auth + remoto de ESTE repo (kit); opcional: ./configure --kit-git"
echo

if [ ! -f "$INDEX" ]; then
  echo "ERROR: no se encuentra $INDEX" >&2
  exit 1
fi

FILE_URL="file://$INDEX"

if [ "$PRINT_ONLY" = "1" ]; then
  echo "Abre en el navegador: $FILE_URL"
  echo "O sirve la carpeta setup:  cd setup && python3 -m http.server $PORT"
  exit 0
fi

if command -v python3 >/dev/null 2>&1; then
  echo "Sirviendo setup en http://127.0.0.1:$PORT/ (Ctrl+C para parar)"
  if command -v xdg-open >/dev/null 2>&1; then
    (sleep 0.4 && xdg-open "http://127.0.0.1:$PORT/" ) >/dev/null 2>&1 &
  elif command -v open >/dev/null 2>&1; then
    (sleep 0.4 && open "http://127.0.0.1:$PORT/" ) >/dev/null 2>&1 &
  else
    echo "Abre manualmente: http://127.0.0.1:$PORT/"
  fi
  cd "$SETUP_DIR"
  exec python3 -m http.server "$PORT" --bind 127.0.0.1
fi

echo "Python3 no encontrado. Abre: $FILE_URL"
exit 0
