#!/usr/bin/env bash
# configure — asistente post-clone del kit (capas A/B/C). No usa askbox /settings/git.
#
# Uso:
#   ./configure              sirve setup/ en HTTP (LAN por defecto) y abre 127.0.0.1 en el navegador
#   ./configure --open-file  abre setup/index.html sin servidor (xdg-open / sensible-browser)
#   ./configure --print      solo imprime la URL file:// y los pasos
#   ./configure --kit-git    inicializa .askbox/git-settings.json del kit (capa C)
#
#   CONFIGURE_HOST (default 0.0.0.0) — interfaz del http.server; 127.0.0.1 solo localhost
#   CONFIGURE_PORT (default 8765)
#
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SETUP_DIR="$ROOT/setup"
INDEX="$SETUP_DIR/index.html"
HOST="${CONFIGURE_HOST:-0.0.0.0}"
PORT="${CONFIGURE_PORT:-8765}"
PRINT_ONLY=0
OPEN_FILE=0

configure_lan_ip() {
  local ip=""
  if command -v ip >/dev/null 2>&1; then
    ip="$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i <= NF; i++) if ($i == "src") { print $(i + 1); exit }}')"
  fi
  if [ -z "$ip" ] && command -v hostname >/dev/null 2>&1; then
    ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
  fi
  printf '%s' "$ip"
}

print_serve_urls() {
  echo "  Local:  http://127.0.0.1:$PORT/"
  local lan
  lan="$(configure_lan_ip)"
  if [ -n "$lan" ] && [ "$HOST" != "127.0.0.1" ]; then
    echo "  Red:    http://${lan}:$PORT/  (otros equipos en la LAN)"
  elif [ "$HOST" = "127.0.0.1" ]; then
    echo "  (solo localhost; para LAN: CONFIGURE_HOST=0.0.0.0 ./configure)"
  fi
}
INIT_KIT_GIT=0

open_setup_file() {
  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$INDEX"
    return 0
  fi
  if command -v sensible-browser >/dev/null 2>&1; then
    sensible-browser "$INDEX"
    return 0
  fi
  if command -v open >/dev/null 2>&1; then
    open "$INDEX"
    return 0
  fi
  echo "No hay xdg-open/sensible-browser. Abre: $FILE_URL" >&2
  return 1
}

for arg in "$@"; do
  case "$arg" in
    --print) PRINT_ONLY=1 ;;
    --open-file) OPEN_FILE=1 ;;
    --kit-git) INIT_KIT_GIT=1 ;;
    -h|--help)
      sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
  esac
done

if [ "$INIT_KIT_GIT" = "1" ]; then
  if [ ! -f "$ROOT/.askbox/git-settings.json" ] && [ -f "$ROOT/.askbox/git-settings.json.example" ]; then
    mkdir -p "$ROOT/.askbox"
    cp "$ROOT/.askbox/git-settings.json.example" "$ROOT/.askbox/git-settings.json"
    echo "Capa C: creado $ROOT/.askbox/git-settings.json (edítalo y configura gh/remoto del kit)."
  else
    echo "Capa C: .askbox/git-settings.json ya existe o falta el .example."
  fi
fi

echo "cursor-agent-orchestrator — configuración post-clone"
echo "  Repo:    $ROOT"
echo "  Guía UI: $INDEX"
echo "  Docs:    $ROOT/docs/getting-started-after-clone.md"
echo
echo "Pasos rápidos:"
echo "  1) Capa A — export ASKBOX_API_URL y ASKBOX_ACCESS_TOKEN (entorno Cursor/host)"
echo "  2) Capa B — ./install.sh /ruta/a/tu-proyecto  (+ git/gh en ese proyecto)"
echo "  3) Capa C — gh auth + remoto de ESTE repo (kit); opcional: ./configure --kit-git"
echo

if [ ! -f "$INDEX" ]; then
  echo "ERROR: no se encuentra $INDEX" >&2
  exit 1
fi

FILE_URL="file://$INDEX"

if [ "$PRINT_ONLY" = "1" ]; then
  echo "Abre en el navegador: $FILE_URL"
  echo "Sin servidor:  ./configure --open-file"
  echo "O sirve la carpeta setup (bind $HOST):"
  print_serve_urls
  echo "  Comando:  cd setup && python3 -m http.server $PORT --bind $HOST"
  exit 0
fi

if [ "$OPEN_FILE" = "1" ]; then
  echo "Abriendo guía sin servidor HTTP: $INDEX"
  open_setup_file
  exit 0
fi

if command -v python3 >/dev/null 2>&1; then
  echo "Sirviendo setup en $HOST:$PORT (Ctrl+C para parar)"
  print_serve_urls
  if command -v xdg-open >/dev/null 2>&1; then
    (sleep 0.4 && xdg-open "http://127.0.0.1:$PORT/" ) >/dev/null 2>&1 &
  elif command -v open >/dev/null 2>&1; then
    (sleep 0.4 && open "http://127.0.0.1:$PORT/" ) >/dev/null 2>&1 &
  fi
  cd "$SETUP_DIR"
  exec python3 -m http.server "$PORT" --bind "$HOST"
fi

echo "Python3 no encontrado. Prueba: ./configure --open-file"
echo "O abre: $FILE_URL"
exit 0
