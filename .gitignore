# Backups generados por install.sh en proyectos destino (no deberían vivir en este repo)
*.bak-*

# Archivos locales comunes
__pycache__/
.DS_Store
*.swp

# Nunca secretos ni entornos reales en este kit
.env
.env.*
!*.env.example

# Auto-update local por máquina (rutas de proyectos, logs, estado cron)
.askbox/orchestrator-targets
.askbox/installations.json
.askbox/auto-update.log
.askbox/auto-update.state
