# Copia a .env junto a docker-compose.yml (gitignored si contiene secretos).
# Rutas absolutas recomendadas en servidor.

ORCHESTRATOR_KIT_PATH=/srv/softportweb/cursor-agent-orchestrator
HOST_ROOT=/srv
# Home: cp compose.override.example.yml → docker-compose.override.yml
CONFIGURE_PORT=8765
# CONFIGURE_TOKEN=genera-un-token-largo
ORCHESTRATOR_UID=1000
ORCHESTRATOR_GID=1000
